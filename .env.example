# Frontend environment variables — copy to .env.local for local dev.
# VITE_API_URL=/api keeps requests same-origin in both `vite dev` (proxied
# by vite.config.ts) and the deployed Worker (which serves API + static
# assets from the same origin) — avoids CORS entirely.
VITE_API_URL=/api

# Optional Google/GitHub sign-in buttons — public values, not secrets, safe
# to commit if you fill these in for real. Leave blank to hide the buttons.
# Also requires enabling the Google/GitHub providers in Appwrite's console
# (Auth > Settings) and registering this deployment's origin as a Web
# Platform there.
# VITE_APPWRITE_ENDPOINT=
# VITE_APPWRITE_PROJECT_ID=

# Optional app-shell display font override (expects a self-hosted WOFF2 URL).
# VITE_EXCALIDASH_UI_FONT_FAMILY=MyFont
# VITE_EXCALIDASH_UI_FONT_URL=/fonts/my-font.woff2
